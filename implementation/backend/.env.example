# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
EXPOSE_DOCS=false
TRUSTED_HOSTS=localhost,127.0.0.1,::1

# Stats API key for telemetry (optional)
STATS_API_KEY=secret-stats-api-key

# Auth + request hardening
# If API_KEY is set, protected QA endpoints require:
# - X-API-Key: <API_KEY>
# or
# - Authorization: Bearer <API_KEY>
API_KEY=
MAX_REQUEST_BODY_BYTES=1048576
ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
SUPPRESS_ORKG_PAGED_FALSE_WARNING=true

# Retrieval secrets
ORKG_EMAIL=
ORKG_PASSWORD=
OPENAI_API_KEY=
VDL_API_KEY=
VDL_API_BASE=https://chat.vdl.sdq.kastel.kit.edu/api
